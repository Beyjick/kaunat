    if show then
        screenDarken.Visible = true
        TweenService:Create(screenDarken, TweenInfo.new(0.3), {BackgroundTransparency = 0.75}):Play()
        TweenService:Create(mainBlur, TweenInfo.new(0.3), {Size = 10}):Play()
    else
        local tween = TweenService:Create(screenDarken, TweenInfo.new(0.3), {BackgroundTransparency = 1})
        TweenService:Create(mainBlur, TweenInfo.new(0.3), {Size = 0}):Play()
