---------------------------------------------------------------------
-- UTILITY FUNCTIONS & HOVER EFFECTS
---------------------------------------------------------------------
local function applyMobileScale(frame)
    if isMobile then
        local scale = Instance.new("UIScale")

        local screenSize = workspace.CurrentCamera.ViewportSize
        
        -- 🔥 use WIDTH instead of height
        local baseWidth = 440
        local scaleFactor = math.clamp(screenSize.X / baseWidth, 0.44, 0.58)

        scale.Scale = scaleFactor
        scale.Parent = frame
    end
end

local function formatNumber(n)
    if not n then return "0" end
    return tostring(math.floor(n)):reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
end

local function makeDraggable(frame)
    local dragging, dragInput, dragStart, startPos
    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    frame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then dragInput = input end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            TweenService:Create(frame, TweenInfo.new(0.05), {
                Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            }):Play()
        end
    end)
end

local function createBuyPanel(name, w, h, parent, draggable)
    local f = Instance.new("Frame") 
    f.Name = name
    f.Size = UDim2.new(0, w, 0, h)
    f.AnchorPoint = Vector2.new(0.5, 0.5)
    f.Position = UDim2.new(0.5, 0, 0.5, 0)
    f.BackgroundColor3 = BuyColors.BgDark
    f.BorderSizePixel = 0
    f.ZIndex = 20 
    f.Parent = parent
    Instance.new("UICorner", f).CornerRadius = UDim.new(0, 10)
    if draggable then makeDraggable(f) end
    return f
end

local function applyHoverScale(obj, targetScaleFactor)
    local originalSize = obj.Size
    local targetSize = UDim2.new(originalSize.X.Scale, originalSize.X.Offset + targetScaleFactor, originalSize.Y.Scale, originalSize.Y.Offset + targetScaleFactor)
    obj.MouseEnter:Connect(function() TweenService:Create(obj, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = targetSize}):Play() end)
    obj.MouseLeave:Connect(function() TweenService:Create(obj, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = originalSize}):Play() end)
end

local function fadeGroup(container, targetTransparency, timeInfo)
    TweenService:Create(container, timeInfo, {BackgroundTransparency = targetTransparency}):Play()
    for _, v in pairs(container:GetDescendants()) do
        if v:IsA("TextLabel") or v:IsA("TextBox") then
            TweenService:Create(v, timeInfo, {TextTransparency = targetTransparency}):Play()
        elseif v:IsA("ImageLabel") then
            TweenService:Create(v, timeInfo, {ImageTransparency = targetTransparency}):Play()
        elseif v:IsA("TextButton") then
            TweenService:Create(v, timeInfo, {TextTransparency = targetTransparency}):Play()
            if v.Name == "CloseButton" then
                TweenService:Create(v, timeInfo, {BackgroundTransparency = 1}):Play()
            else
                TweenService:Create(v, timeInfo, {BackgroundTransparency = targetTransparency}):Play()
            end
        elseif v:IsA("Frame") and v.Name == "FillBar" then
            TweenService:Create(v, timeInfo, {BackgroundTransparency = targetTransparency}):Play()
        end
    end
end

