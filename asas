    fillBar.BackgroundTransparency = 0
    
    for _, v in pairs(buyFrame:GetDescendants()) do
       if v:IsA("TextLabel") or v:IsA("TextBox") then v.TextTransparency = 0
       elseif v:IsA("ImageLabel") then v.ImageTransparency = 0
       elseif v:IsA("TextButton") then
           if v.Name ~= "CloseButton" then v.BackgroundTransparency = 0 end
           v.TextTransparency = 0
       end
    end

