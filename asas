local fillTween
local debounce = false 
local isFillComplete = false

local function toggleOverlay(show)
    modalOverlay.Visible = true
    local targetAlpha = show and 0.6 or 1
    local tInfo = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local tween = TweenService:Create(modalOverlay, tInfo, {BackgroundTransparency = targetAlpha})
    tween:Play()
    if not show then
        tween.Completed:Connect(function()
            if modalOverlay.BackgroundTransparency == 1 then modalOverlay.Visible = false end
        end)
    end
end

local function startFill()
    isFillComplete = false 
    fillBar.Size = UDim2.new(0, 0, 1, 0) 
    fillBar.Visible = true
    fillBar.BackgroundTransparency = 0 
    
    local tweenInfo = TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In) 
    fillTween = TweenService:Create(fillBar, tweenInfo, {Size = UDim2.new(1, 0, 1, 0)})
    fillTween.Completed:Connect(function(playbackState)
        if playbackState == Enum.PlaybackState.Completed then isFillComplete = true end
    end)
    fillTween:Play()
end

local function updateProfileImage(username)
    if username == "" or username == nil then
        searchProfilePic.Image = "" 
        centerAvatarBtn.Visible = false
        confirmBtn.Visible = false
        displayNameLabel.Text = ""
        usernameLabel.Text = ""
        return
    end

    displayNameLabel.Text = "Searching..."
    usernameLabel.Text = ""

    task.spawn(function()
        local success, userId = pcall(function() return Players:GetUserIdFromNameAsync(username) end)

        if success and userId then
            local pop = Instance.new("Sound")
            pop.SoundId = ASSETS.PopSound
            pop.Volume = 0.5
            pop.Parent = giftFrame
            pop:Play()
            game.Debris:AddItem(pop, 1)

            local content, isReady = Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
            if isReady then searchProfilePic.Image = content end
            
            local bodyContent, bodyReady = Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.AvatarThumbnail, Enum.ThumbnailSize.Size420x420)
            if bodyReady then 
                centerAvatarBtn.Image = bodyContent 
                centerAvatarBtn.Visible = true
                confirmBtn.Visible = true
            end

            local infoSuccess, userInfo = pcall(function() return UserService:GetUserInfosByUserIdsAsync({userId}) end)

            if infoSuccess and userInfo[1] then
                displayNameLabel.Text = userInfo[1].DisplayName
                usernameLabel.Text = "@" .. userInfo[1].Username
            else
                displayNameLabel.Text = username
                usernameLabel.Text = "@" .. username
            end
        else
            searchProfilePic.Image = ""
            centerAvatarBtn.Visible = false
            confirmBtn.Visible = false
            displayNameLabel.Text = "Player not found"
            usernameLabel.Text = ""
        end
    end)
end

