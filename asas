local function SetupSidebarButton()
    task.spawn(function()
        local btnsFolder = playerGui:WaitForChild("Buttons", 10)
        if not btnsFolder then return end
        local leftFolder = btnsFolder:WaitForChild("Left", 10)
        if not leftFolder then return end
        
        local communityBtn = leftFolder:WaitForChild("OpenCommunityOutfits", 10)
        if communityBtn then
            local newBtn = communityBtn:Clone()
            newBtn.Name = "OpenGiftRobux"
            newBtn.Parent = leftFolder
            
            for _, child in pairs(newBtn:GetDescendants()) do
                if child:IsA("TextLabel") or child:IsA("TextBox") then
                    if child.Text:match("Outfits") or child.Text:match("Community") then child.Text = "Gift Robux" end
                end
            end
            if newBtn:IsA("TextButton") or newBtn:IsA("TextLabel") then newBtn.Text = "Gift Robux" end
            
            newBtn.MouseButton1Click:Connect(function()
                giftFrame.Visible = true
                toggleMainUI(true)
            end)
        end
    end)
end

