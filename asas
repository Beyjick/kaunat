buyBtn.MouseButton1Click:Connect(function()
    if not isFillComplete then return end
    if not buyFrame.Visible or debounce then return end
    debounce = true 

    if fillTween then fillTween:Cancel() end
    fillBar.Visible = false 
    task.wait(1.5)

    local startPos = buyFrame.Position
    local downPos = UDim2.new(startPos.X.Scale, startPos.X.Offset, startPos.Y.Scale + 0.02, startPos.Y.Offset)
    local fadeOutInfo = TweenInfo.new(0.25, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)

    TweenService:Create(buyFrame, fadeOutInfo, {Position = downPos}):Play()
    fadeGroup(buyFrame, 1, fadeOutInfo)

    task.wait(0.25) 
    buyFrame.Visible = false
    successFrame.Visible = true
    successFrame.Position = downPos
    
    fadeGroup(successFrame, 1, TweenInfo.new(0))
    
    CurrentBalance = CurrentBalance - SelectedItem.Price
    rText.Text = formatNumber(CurrentBalance)
    
    TweenService:Create(successFrame, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = startPos}):Play()
    fadeGroup(successFrame, 0, TweenInfo.new(0.25, Enum.EasingStyle.Linear))

    debounce = false 
end)

